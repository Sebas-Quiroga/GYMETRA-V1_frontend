# Archivo de configuración local para desarrollo
# Este archivo tiene prioridad sobre .env.development
# Copia este archivo y modifícalo según tu configuración de red

# URLs de los servicios backend
VITE_API_URL=http://localhost:8080/api/auth
VITE_MEMBERSHIP_API_URL=http://localhost:8081/api
VITE_API_BASE_URL=http://localhost:8081/api

# Si tu IP local cambia, modifica estas líneas:
# VITE_API_URL=http://192.168.1.100:8080/api/auth
# VITE_MEMBERSHIP_API_URL=http://192.168.1.100:8081/api
# VITE_API_BASE_URL=http://192.168.1.100:8081/api